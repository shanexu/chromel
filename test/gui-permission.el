;;; gui-permission.el --- Permission prompts reach Emacs and are remembered -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defvar chromel-test--buffer nil)
(defvar chromel-test--asked nil)
(defvar chromel-test--origin nil)
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--finish (ok text)
  (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (if ok "PASS: " "FAIL: ") text "\n"))
  (kill-emacs (if ok 0 1)))
(defun chromel-test--until (predicate text seconds)
  (let ((deadline (+ (float-time) seconds)) done)
    (while (and (not done) (< (float-time) deadline))
      (setq done (funcall predicate))
      (unless done (accept-process-output nil 0.01)))
    (chromel-test--assert done (format "%s; title=%S asked=%S"
                                       text
                                       (and (buffer-live-p chromel-test--buffer)
                                            (buffer-local-value 'chromel--title chromel-test--buffer))
                                       chromel-test--asked))))
(defun chromel-test--title-p (expected)
  (lambda ()
    (and (buffer-live-p chromel-test--buffer)
         (equal (buffer-local-value 'chromel--title chromel-test--buffer) expected))))
(defun chromel-test--origin-of ()
  "Scheme, host and port of the fixture server."
  (string-remove-suffix "/fixture" (getenv "CHROMEL_TEST_URL")))
(defun chromel-test--run ()
  (condition-case error
      (let ((chromel-permission-policy nil))
        (clrhash chromel--permission-answers)
        (setq chromel-test--origin (chromel-test--origin-of))
        ;; A real question would wait for a person; the test answers "yes" and
        ;; checks that it is asked exactly once per origin and permission.
        (cl-letf (((symbol-function 'chromel--permission-ask)
                   (lambda (origin names)
                     (push (cons origin names) chromel-test--asked)
                     t)))
          (setq chromel-test--buffer (chromel (concat chromel-test--origin "/permission")))
          (chromel-test--until (chromel-test--title-p "perm:granted")
                               "The page was not granted notifications" 25)
          (chromel-test--assert (= (length chromel-test--asked) 1)
                                (format "Expected exactly one question: %S" chromel-test--asked))
          (let ((asked (car chromel-test--asked)))
            (chromel-test--assert (string-prefix-p chromel-test--origin (car asked))
                                  (format "Wrong origin in prompt: %S" asked))
            (chromel-test--assert (equal (cdr asked) '("notifications"))
                                  (format "Wrong permission in prompt: %S" asked)))
          ;; Same origin, same permission, another page: the answer is remembered.
          (setq chromel-test--buffer
                (chromel (concat chromel-test--origin "/permission?second")))
          (chromel-test--until (chromel-test--title-p "perm:granted?second")
                               "The remembered answer did not apply" 25)
          (chromel-test--assert (= (length chromel-test--asked) 1)
                                (format "The second request asked again: %S" chromel-test--asked)))
        (chromel-test--finish t "permissions are asked once and remembered"))
    (error (chromel-test--finish nil (error-message-string error)))))
(run-at-time 1 nil #'chromel-test--run)
