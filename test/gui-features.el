;;; gui-features.el --- Search, scrolling and link workflow regressions -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defvar chromel-test--source nil)
(defvar chromel-test--busy nil)
(defvar chromel-test--phase 'loading)
(defvar chromel-test--deadline (+ (float-time) 50))
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--js (expression) (chromel--eval (concat "JSON.stringify(" expression ")")))
(defun chromel-test--until (expression text)
  (let ((deadline (+ (float-time) 4)) done)
    (while (and (not done) (< (float-time) deadline))
      (setq done (eq t (chromel-test--js expression)))
      (unless done (accept-process-output nil 0.01)))
    (chromel-test--assert done (format "%s; state=%S focus=%s" text
                                  (chromel-test--js "({y:scrollY,panel:document.getElementById('panel').scrollTop,child:childState,active:document.activeElement.tagName})")
                                  (chromel--native-inspect chromel--id)))))
(defun chromel-test--finish (ok text)
  (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (if ok "PASS: " "FAIL: ") text "\n"))
  (kill-emacs (if ok 0 1)))
(defun chromel-test--click (x y &optional frame)
  (chromel-focus)
  (chromel--command "click" (chromel--json (list :x x :y y :newBuffer :false)))
  (accept-process-output nil 0.05)
  ;; Cross-process focus acknowledgement is asynchronous.  Test routing only
  ;; after CEF confirms the intended frame, rather than assuming 50 ms suffices.
  (when frame
    (let ((deadline (+ (float-time) 3)) focused)
      (while (and (not focused) (< (float-time) deadline))
        (chromel--tick)
        (setq focused (equal frame (plist-get (json-parse-string
                                               (chromel--native-inspect chromel--id) :object-type 'plist)
                                              :focusedFrameName)))
        (unless focused (accept-process-output nil 0.01)))
      (chromel-test--assert focused "CEF did not acknowledge clicked iframe focus")))
  (chromel--command "unfocus"))
(defun chromel-test--search ()
  (chromel-test--until "childState!==null" "Cross-origin frame did not load")
  (chromel-find "needlefeature")
  (chromel-test--assert (= chromel--find-count 4) (format "Find missed visible/frame matches: %d" chromel--find-count))
  (let ((ordinal chromel--find-ordinal))
    (chromel-find-next)
    (chromel-test--assert (= chromel--find-ordinal (1+ (mod ordinal 4))) "Next match did not advance/wrap")
    (chromel-find-previous)
    (chromel-test--assert (= chromel--find-ordinal ordinal) (format "Previous match did not return: initial=%d now=%d count=%d" ordinal chromel--find-ordinal chromel--find-count)))
  (chromel-find "中文检索")
  (chromel-test--assert (= chromel--find-count 3) "Unicode search failed")
  (chromel-find "[literal.*]")
  (chromel-test--assert (= chromel--find-count 1) "Search interpreted literal punctuation as a regex")
  (chromel-find "missing-feature-token")
  (chromel-test--assert (= chromel--find-count 0) "No-match search retained stale count")
  (chromel-find-clear)
  (chromel-test--assert (and (not chromel--find-active) (equal chromel--find-status "")) "Search clear retained status")
  (chromel-find "needlefeature")
  (chromel-find-clear)
  (chromel-find-next)
  (chromel-test--assert (and (= chromel--find-count 4) (> chromel--find-ordinal 0)) "Repeating a cleared query did not restart search")
  (chromel-find-clear)
  (chromel-focus-parent-frame t)
  (let ((deadline (+ (float-time) 3)))
    (while (and (< (float-time) deadline)
                (not (equal "" (plist-get (json-parse-string (chromel--native-inspect chromel--id) :object-type 'plist) :focusedFrameName))))
      (chromel--tick) (accept-process-output nil 0.01)))
  (chromel-scroll-to-top)
  (chromel-test--until "scrollY===0" "Search reset did not return to top"))
(defun chromel-test--scroll ()
  (let ((chromel-scroll-duration 0))
    (chromel-scroll-half-page-down)
    (chromel-test--until "scrollY===Math.round(document.scrollingElement.clientHeight/2)" "Half-page down used a fixed pixel step")
    (chromel-scroll-half-page-up)
    (chromel-test--until "scrollY===0" "Half-page up failed")
    (chromel-scroll-to-bottom)
    (chromel-test--until "scrollY===document.scrollingElement.scrollHeight-document.scrollingElement.clientHeight" "Bottom failed")
    (chromel-scroll-to-top)
    (chromel-test--until "scrollY===0" "Top failed")
    (chromel-test--click 80 115)
    (chromel-scroll-half-page-down)
    (chromel-test--until "document.getElementById('panel').scrollTop===100 && scrollY===0" "Half-page did not use panel height")
    (chromel-scroll-to-bottom)
    (chromel-test--until "document.getElementById('panel').scrollTop===800 && scrollY===0" "Bottom did not stay in panel")
    (chromel-scroll-to-top)
    (chromel-test--until "document.getElementById('panel').scrollTop===0" "Top did not stay in panel")
    (chromel-scroll-to-top)
    (chromel-test--until "scrollY===0" "Top at panel boundary escaped to outer page")
    ;; The cross-origin frame sits at x 500..730, but the last 16 CSS px of the
    ;; 560 px view (500..543 usable) belong to the overlay scrollbar strip and
    ;; never hit-test into page content, so aim well inside the frame instead.
    (chromel-test--click 520 120 "feature-child")
    (chromel-scroll-half-page-down)
    (chromel-test--until "childState.y===Math.round(childState.height/2) && scrollY===0" "Half-page did not route to cross-origin iframe")
    (chromel-scroll-to-bottom)
    (chromel-test--until "childState.y===childState.max" "Bottom did not route to iframe")
    (chromel-scroll-to-top)
    (chromel-test--until "childState.y===0" "Top did not route to iframe")
    (chromel-focus-parent-frame t)))
(defun chromel-test--links ()
  ;; Keep the user's clipboard out of automated tests; capture kill-new values.
  (let (copied)
    (cl-letf (((symbol-function 'kill-new) (lambda (text &rest _) (setq copied text))))
      (chromel-copy-url)
      (chromel-test--assert (equal copied chromel--url) "Current URL was not copied")
      (setq chromel-test--phase 'copy)
      (let* ((hints (chromel--eval (format "%s(\"as\",\"inspect\",\"copy\")" (chromel--hint-script))))
             (hint (cl-find "中文 link" hints :key (lambda (h) (plist-get h :title)) :test #'equal)))
        (chromel-test--assert (= 4 (length hints)) "Copy hints included buttons/hidden links")
        (chromel--eval (chromel--hint-call "inspect" "clear"))
        (let ((unread-command-events (string-to-list (plist-get hint :label))) (chromel-hint-alphabet "as"))
          (chromel-copy-link))
        (chromel-test--assert (equal copied (chromel-test--js "document.getElementById('unicode').href")) "Link URL encoding/copy failed")
        (chromel-test--assert (= 0 (chromel-test--js "clicks")) "Copy triggered a link click"))))
  (setq chromel-test--phase 'queue)
  (let* ((hints (chromel--eval (format "%s(\"as\",\"inspect\",\"queue\")" (chromel--hint-script))))
         (keys (append (string-to-list (plist-get (nth 0 hints) :label))
                       (string-to-list (plist-get (nth 1 hints) :label))
                       (string-to-list (plist-get (nth 3 hints) :label)) '(escape)))
         (chromel-hint-alphabet "as"))
    (chromel--eval (chromel--hint-call "inspect" "clear"))
    (cl-letf (((symbol-function 'read-key) (lambda (&rest _) (or (pop keys) (error "Queue did not terminate")))))
      (chromel-follow-multiple)))
  (chromel-test--until "clicks===3 && intercepts===1" "Queued links bypassed real click handlers")
  (chromel-test--assert (eq (window-buffer (selected-window)) chromel-test--source) "Queue selected a new buffer")
  (chromel-test--until "document.querySelectorAll('[data-emacs-chromel-hints]').length===0" "Queue cancel left labels behind")
  (setq chromel-test--phase 'background))
(defun chromel-test--step ()
  (unless chromel-test--busy
    (let ((chromel-test--busy t))
      (condition-case err
          (with-current-buffer (if (buffer-live-p chromel-test--source) chromel-test--source (current-buffer))
            (when (> (float-time) chromel-test--deadline) (error "Feature test timed out: %s" chromel-test--phase))
            (pcase chromel-test--phase
              ('loading
               (when (equal chromel--title "features-ready")
                 (switch-to-buffer chromel-test--source) (delete-other-windows) (chromel--sync)
                 (when (fboundp 'meow-normal-mode) (meow-normal-mode 1))
                 (dolist (entry '(("C-c w s" . chromel-find) ("C-c w d" . chromel-scroll-half-page-down)
                                  ("C-c w f" . chromel-copy-link) ("C-c w m" . chromel-follow-multiple)))
                   (chromel-test--assert (eq (key-binding (kbd (car entry))) (cdr entry))
                                    (concat "Meow overrode " (car entry))))
                 (setq chromel-test--phase 'search) (chromel-test--search)
                 (setq chromel-test--phase 'scroll) (chromel-test--scroll)
                 (setq chromel-test--phase 'links) (chromel-test--links)))
              ('background
               (let ((others (cl-remove chromel-test--source (hash-table-values chromel--pages))))
                 (when (and (= (length others) 2)
                            (cl-every (lambda (b) (string-prefix-p "feature-target-" (buffer-local-value 'chromel--title b))) others))
                   (dolist (b others)
                     (with-current-buffer b
                       (let ((info (json-parse-string (chromel--native-inspect chromel--id) :object-type 'plist)))
                         (chromel-test--assert (and (eq t (plist-get info :hidden)) (eq :false (plist-get info :focused))) "Background browser became visible/focused"))
                       (chromel-test--assert (equal chromel--find-text "") "Search state leaked to another buffer")))
                   (chromel-test--assert (eq (window-buffer (selected-window)) chromel-test--source) "Late loading stole source selection")
                   (mapc #'kill-buffer others)
                   (setq chromel-test--phase 'closing)
                   (kill-buffer chromel-test--source))))))
        (error (chromel-test--finish nil (format "%s (phase %s)" (error-message-string err) chromel-test--phase))))))
  (when (and (eq chromel-test--phase 'closing) (string-match-p "Browsers including DevTools: 0" (chromel--native-info)))
    (chromel-test--finish t "Find including cross-origin/Unicode/repeat/no-match; half/top/bottom in page/panel/frame; copy without clicks; queued background links preserve focus and handlers")))
(run-at-time 1 nil (lambda ()
                    (setq chromel-test--source (chromel (getenv "CHROMEL_TEST_URL")))
                    (run-at-time 0.2 0.2 #'chromel-test--step)))
