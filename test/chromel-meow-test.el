;;; chromel-meow-test.el --- Optional integration with the real Meow package -*- lexical-binding: t; -*-
(require 'ert)
(require 'meow)
(meow-motion-define-key '("j" . meow-next) '("k" . meow-prev))
(defconst chromel-test--original-motion-map (copy-keymap meow-motion-state-keymap))
(require 'chromel)
(meow-global-mode 1)

(ert-deftest chromel-meow-motion-keeps-keypad-and-browser-keys ()
  (with-temp-buffer
    (chromel-mode)
    (meow-mode 1)
    (should (eq meow--current-state 'motion))
    (should (equal meow-motion-state-keymap chromel-test--original-motion-map))
    (should (eq (key-binding (kbd "SPC")) 'meow-keypad))
    (should (equal (lookup-key key-translation-map [escape]) (kbd "C-g")))
    (dolist (pair '(("j" . chromel-scroll-down) ("k" . chromel-scroll-up)
                    ("gg" . chromel-scroll-to-top) ("G" . chromel-scroll-to-bottom)
                    ("r" . chromel-reload) ("H" . chromel-back) ("L" . chromel-forward)
                    ("f" . chromel-follow) ("F" . chromel-follow-background)
                    ("/" . chromel-find) ("n" . chromel-find-next) ("N" . chromel-find-previous)
                    ("yy" . chromel-copy-url) ("yf" . chromel-copy-link)
                    ("d" . chromel-scroll-half-page-down) ("u" . chromel-scroll-half-page-up)
                    ("o" . chromel-open) ("O" . chromel-open-new-url)
                    ("ge" . chromel-open-url) ("gE" . chromel-edit-url-new-buffer)
                    ("t" . chromel-new-tab) ("x" . chromel-close-tab) ("X" . chromel-reopen-closed-tab)
                    ("C-c w ," . chromel-settings) ("C-c w P" . chromel-passwords)
                    ("C-c w e" . chromel-extensions) ("C-c w E" . chromel-extension-store) ("C-c w s" . chromel-find) ("C-c w S" . chromel-save-session) ("C-c w R" . chromel-restore-session)
                    ("J" . chromel-previous-tab) ("K" . chromel-next-tab)
                    ("gT" . chromel-previous-tab) ("gt" . chromel-next-tab)
                    ("T" . chromel-switch-tab) ("^" . chromel-last-tab)
                    ("p" . chromel-open-copied-url) ("P" . chromel-open-copied-url-new-buffer)
                    ("gF" . chromel-focus-main-frame) ("C-c w h" . chromel-history)))
      (should (eq (key-binding (kbd (car pair))) (cdr pair))))))

(ert-deftest chromel-meow-other-buffers-unchanged ()
  (with-temp-buffer
    (special-mode)
    (meow-mode 1)
    (should (eq meow--current-state 'motion))
    (should (eq (key-binding "j") 'meow-next))
    (should (eq (key-binding "k") 'meow-prev))
    (should (eq (key-binding (kbd "SPC")) 'meow-keypad))
    (should (eq (key-binding [escape]) 'meow-last-buffer))))
