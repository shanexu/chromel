;;; gui-blocker.el --- A blocked request never leaves the browser -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defvar chromel-test--buffer nil)
(defvar chromel-test--origin nil)
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--finish (ok text)
  (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (if ok "PASS: " "FAIL: ") text "\n"))
  (kill-emacs (if ok 0 1)))
(defun chromel-test--until (predicate text seconds)
  (let ((deadline (+ (float-time) seconds)) done)
    (while (and (not done) (< (float-time) deadline))
      (setq done (funcall predicate))
      (unless done (accept-process-output nil 0.01)))
    (chromel-test--assert done (format "%s; title=%S info=%S"
                                       text
                                       (and (buffer-live-p chromel-test--buffer)
                                            (buffer-local-value 'chromel--title chromel-test--buffer))
                                       (and (fboundp 'chromel--native-blocklist-info)
                                            (chromel--native-blocklist-info))))))
(defun chromel-test--title-p (expected)
  (lambda ()
    (and (buffer-live-p chromel-test--buffer)
         (equal (buffer-local-value 'chromel--title chromel-test--buffer) expected))))
(defun chromel-test--run ()
  (condition-case error
      (let* ((directory (make-temp-file "chromel-blocker" t))
             (file (expand-file-name "blocklist.txt" directory)))
        (with-temp-file file (insert "b\t0\t\th=localhost\n"))
        ;; The blocker loads this file when the browser starts.  The page is on
        ;; 127.0.0.1 and its image on `localhost' -- same server, different host
        ;; string -- so the rule matches the image and nothing else.
        (setq chromel-blocklist-file file)
        (setq chromel--blocker-exceptions nil)
        (setq chromel-test--origin (string-remove-suffix "/blocker" (getenv "CHROMEL_TEST_URL")))
        (setq chromel-test--buffer (chromel (concat chromel-test--origin "/blocker")))
        (chromel-test--until (chromel-test--title-p "ad-blocked")
                             "The blocked image still loaded" 25)
        (chromel-test--assert (string-match-p "rules=1" (chromel--native-blocklist-info))
                              "The one-rule blocklist was not the live list")
        ;; Opt this site out and reload: the same request must now reach the
        ;; server, which is what proves the cancel was ours and not a dead host.
        (setq chromel--blocker-exceptions '("127.0.0.1"))
        (chromel--blocker-apply)
        (with-current-buffer chromel-test--buffer (chromel-reload))
        (chromel-test--until (chromel-test--title-p "ad-loaded")
                             "The image did not load after the site opted out" 25)
        (delete-directory directory t)
        (chromel-test--finish t "blocked requests are cancelled and the site can opt out"))
    (error (chromel-test--finish nil (error-message-string error)))))
(run-at-time 1 nil #'chromel-test--run)
